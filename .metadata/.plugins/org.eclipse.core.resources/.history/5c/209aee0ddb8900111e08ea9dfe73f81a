spring.application.name=SuperUser
server.port=8088
spring.datasource.url=jdbc:mysql://localhost:3306/messageuser
spring.datasource.username=root
spring.datasource.password=

#spring.datasource.username=${DB_USERNAME:root}

#spring.datasource.password=${DB_PASSWORD:}

#spring.datasource.url=${DB_URL:jdbc:mysql://mysql:3306/superuser}

spring.kafka.bootstrap-servers=${KAFKA_SERVERS:kafka:9092}

eureka.client.service-url.defaultZone=${EUREKA_SERVER:http://eureka:8761/eureka/}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Eureka

eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true

# JWT
jwt.secret=SuperUserAdminSecretKeyMustBeAtLeast256BitsLongForJwtSigning123

jwt.access-expiration=3600000
jwt.refresh-expiration=604800000

# Internal API
internal.api.key=WHOAMI_INTERNAL_2026

# Logging
logging.level.org.springframework.security=DEBUG
server.address=0.0.0.0

spring.jpa.show-sql=true
spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.format_sql=true
