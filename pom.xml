<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.whoami</groupId>
    <artifactId>whoami-backend</artifactId>
    <version>1.0.0</version>

    <packaging>pom</packaging>

    <name>WhoAmI Backend Parent</name>

    <!-- ===================================================== -->
    <!-- MODULES -->
    <!-- ===================================================== -->

    <modules>

        <module>Locato-constants</module>

        <module>service-registry</module>

        <module>Gateway</module>

        <module>userRegistry</module>

        <module>shop-service</module>

        <module>OrderService</module>

        <module>Notification-Service</module>

        <module>Servicechat</module>

        <!-- <module>SuperUSer</module> -->

    </modules>

    <!-- ===================================================== -->
    <!-- PROPERTIES -->
    <!-- ===================================================== -->

    <properties>

        <java.version>21</java.version>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven.compiler.release>21</maven.compiler.release>

        <!-- Spring -->

        <spring.boot.version>3.5.15</spring.boot.version>

        <spring-cloud.version>2025.0.0</spring-cloud.version>

        <!-- Libraries -->

        <lombok.version>1.18.42</lombok.version>

        <jjwt.version>0.12.6</jjwt.version>

        <firebase-admin.version>9.7.0</firebase-admin.version>

        <cloudinary.version>2.0.0</cloudinary.version>

        <springdoc.version>2.8.9</springdoc.version>

        <jackson.version>2.20.0</jackson.version>

        <totp.version>1.7.1</totp.version>

        <uuid.version>4.0.1</uuid.version>

    </properties>

    <!-- ===================================================== -->
    <!-- Dependency Management -->
    <!-- ===================================================== -->

    <dependencyManagement>

        <dependencies>

            <dependency>

                <groupId>org.springframework.boot</groupId>

                <artifactId>spring-boot-dependencies</artifactId>

                <version>${spring.boot.version}</version>

                <type>pom</type>

                <scope>import</scope>

            </dependency>

            <dependency>

                <groupId>org.springframework.cloud</groupId>

                <artifactId>spring-cloud-dependencies</artifactId>

                <version>${spring-cloud.version}</version>

                <type>pom</type>

                <scope>import</scope>

            </dependency>

        </dependencies>

    </dependencyManagement>

    <!-- ===================================================== -->
    <!-- Build -->
    <!-- ===================================================== -->

    <build>

        <pluginManagement>

            <plugins>

                <!-- Spring Boot Plugin -->

                <plugin>

                    <groupId>org.springframework.boot</groupId>

                    <artifactId>spring-boot-maven-plugin</artifactId>

                    <version>${spring.boot.version}</version>

                    <executions>

                        <execution>

                            <goals>

                                <goal>repackage</goal>

                            </goals>

                        </execution>

                    </executions>

                </plugin>

                <!-- Compiler Plugin -->

                <plugin>

                    <groupId>org.apache.maven.plugins</groupId>

                    <artifactId>maven-compiler-plugin</artifactId>

                    <version>3.14.0</version>

                    <configuration>

                        <release>${java.version}</release>

                        <parameters>true</parameters>

                        <annotationProcessorPaths>

                            <path>

                                <groupId>org.projectlombok</groupId>

                                <artifactId>lombok</artifactId>

                                <version>${lombok.version}</version>

                            </path>

                        </annotationProcessorPaths>

                    </configuration>

                </plugin>

                <!-- Surefire Plugin -->

                <plugin>

                    <groupId>org.apache.maven.plugins</groupId>

                    <artifactId>maven-surefire-plugin</artifactId>

                    <version>3.5.3</version>

                </plugin>

            </plugins>

        </pluginManagement>

    </build>

</project>